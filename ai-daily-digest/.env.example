# 复制本文件为 .env 并填入你的 API key
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 免费 X：本地推荐 python -m src.x_setup；云端使用下方两个 Secrets。
# 不需要 X 官方 API Key；两项必须同时配置，优先于本地会话文件。
X_AUTH_TOKEN=
X_CT0=

# 旧的付费 X 后端（默认配置不启用；仅显式恢复 last30days 的 x 来源时使用）
XAI_API_KEY=
XQUIK_API_KEY=

# 可选：启用 Bluesky 社区来源
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# 可选：当 YouTube 对云端 IP 触发机器人验证时启用备用通道
SCRAPECREATORS_API_KEY=
